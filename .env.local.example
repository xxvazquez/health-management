# Copy to .env.local for local dev (git-ignored). Without these set,
# the Log page works exactly as before, just without cloud sync (or the
# breakfast reminder, which needs cloud sync anyway) — nothing breaks.
# See supabase/schema.sql for the tables these point at.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public half of a Web Push VAPID keypair — generate one with
# `npx web-push generate-vapid-keys`. The private half is never a
# NEXT_PUBLIC_* var; it's a Supabase secret only (see deploy-functions.yml).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
