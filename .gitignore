# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# personal health data — never committed. All real data lives only in the
# browser's IndexedDB after an in-app import; this repo holds app code only.
/data/

# build artifact regenerated by `npm run sync-wasm` (predev/prebuild hooks)
/public/sql-wasm.wasm

# local tooling config, not part of the app
/.claude/
