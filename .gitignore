# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/out */

# Git's own data, renamed so iCloud Drive doesn't sync it (".git" is a
# one-line pointer to it)
/.git.nosync/

# iCloud Drive leaves "name 2.ext" duplicates when it syncs this folder
* [0-9].*
* [0-9]

# production
/build

# misc
.DS_Store
*.pem
/.claude/
/CLAUDE.md
/PLAN.md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example
.env.local
.env.*.local

# typescript
*.tsbuildinfo
next-env.d.ts

# personal health data — never committed, regardless of where it sits
# locally. The actual data lives in Supabase; nothing in this repo reads
# from this folder.
/data/
/supabase/migration-output/
